{
  "hosting": {"site": "starpumphouse",
    "public": ".",
    "ignore": [
      "docs/**",
      "backups/**",
      "README.md",
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [ { "source": "**/*.@(html|js|css)",
                  "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] } ]
  }
}
